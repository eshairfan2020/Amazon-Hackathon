# ANCHOR AI backend — placeholders only. Copy to .env (never commit .env).
# Node does not load .env automatically: run with `node --env-file=.env src/server.js`
# (the npm scripts do not pass it; export variables or use --env-file yourself).

NODE_ENV=development
PORT=3001
HOST=127.0.0.1
LOG_LEVEL=info

# --- Authentication -------------------------------------------------------
# demo      : DEMO-ONLY identity (DEMO_USER_ID). Refused when NODE_ENV=production.
# supabase  : verifies the frontend's Supabase access token (needs SUPABASE_URL + SUPABASE_ANON_KEY).
# bearer    : static bearer tokens mapped to user ids (AUTH_TOKENS). Required in production.
AUTH_MODE=demo
DEMO_USER_ID=user_esha
# Demo only: lets the frontend pick another *seeded* demo user via the x-demo-user header.
ALLOW_DEMO_USER_SWITCH=true
# bearer mode: comma-separated "token:userId" pairs. Use long random tokens.
AUTH_TOKENS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated emails that get the admin role (others start as manager).
ADMIN_EMAILS=

# --- Data store -----------------------------------------------------------
# memory   : in-process, seeded demo data (works with no AWS)
# dynamodb : requires DYNAMODB_TABLE and AWS credentials from the standard provider chain
REPOSITORY=memory
SEED_ON_START=true
DYNAMODB_TABLE=anchor-ai
AWS_REGION=us-east-1
# Optional (local DynamoDB): DYNAMODB_ENDPOINT=http://localhost:8000

# --- AI -------------------------------------------------------------------
# fallback : deterministic templates (default)
# bedrock  : Amazon Bedrock Converse API; falls back to templates on any failure
AI_PROVIDER=fallback
BEDROCK_MODEL_ID=
BEDROCK_TIMEOUT_MS=8000

# --- HTTP -----------------------------------------------------------------
# Comma-separated allowed browser origins, e.g. http://localhost:3000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=120

# --- Dev evaluator endpoint (POST /api/v1/dev/run-evaluator) --------------
# Enabled by default outside production. In production it is OFF unless
# ENABLE_DEV_ENDPOINTS=true AND a DEV_ADMIN_TOKEN (>=16 chars) is set; callers
# must then also send it in the x-admin-token header.
ENABLE_DEV_ENDPOINTS=true
DEV_ADMIN_TOKEN=

# --- Optional risk-engine overrides (JSON, merged over defaults) ----------
# RISK_CONFIG_JSON={"mediumThreshold":30,"highThreshold":60}

# --- MCP stdio server -----------------------------------------------------
# demo mode: identity comes from DEMO_USER_ID. bearer mode: set ANCHOR_MCP_TOKEN
# to one of the tokens in AUTH_TOKENS.
# ANCHOR_MCP_TOKEN=
